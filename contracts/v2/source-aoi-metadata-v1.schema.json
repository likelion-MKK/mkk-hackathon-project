{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcm-lookbook.example/contracts/v2/source-aoi-metadata-v1.schema.json",
  "title": "SourceAoiMetadataV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "video_id", "manifest_version", "metadata_version", "feature_taxonomy_version", "approval", "source_aois"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "video_id": { "$ref": "#/$defs/id" },
    "manifest_version": { "$ref": "#/$defs/version" },
    "metadata_version": { "$ref": "#/$defs/version" },
    "feature_taxonomy_version": { "$ref": "#/$defs/version" },
    "approval": { "$ref": "#/$defs/approval" },
    "source_aois": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/sourceAoi" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "approved_by", "approved_at", "note"],
      "properties": {
        "status": { "enum": ["pending_review", "approved"] },
        "approved_by": { "type": ["string", "null"], "maxLength": 128 },
        "approved_at": { "type": ["string", "null"], "maxLength": 64 },
        "note": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "allOf": [{
        "if": { "properties": { "status": { "const": "pending_review" } }, "required": ["status"] },
        "then": { "properties": { "approved_by": { "type": "null" }, "approved_at": { "type": "null" } } },
        "else": { "properties": { "approved_by": { "type": "string", "minLength": 1 }, "approved_at": { "type": "string", "minLength": 1 } } }
      }]
    },
    "visualFeatures": {
      "type": "object", "additionalProperties": false,
      "required": ["color_primary", "color_family", "silhouette", "category_type", "patterns", "bag_accessories"],
      "properties": {
        "color_primary": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-z][a-z0-9_]*$" },
        "color_family": { "enum": ["beige", "black", "brown", "metallic", "pink", "unknown"] },
        "silhouette": { "enum": ["backpack", "boston", "east_west_shoulder", "pouch", "shopper", "tambourine", "tote", "vanity_case", "weekender"] },
        "category_type": { "enum": ["backpack", "crossbody_bag", "pouch", "shoulder_bag", "top_handle_bag", "tote_bag", "travel_bag", "vanity_case"] },
        "patterns": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "enum": ["crystal", "grained_leather", "monogram", "solid", "studded", "unknown"] } },
        "bag_accessories": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "enum": ["front_pocket", "lock", "logo_plaque", "shoulder_strap", "side_studs", "tag", "top_handle", "zipper"] } }
      }
    },
    "sourceAoi": {
      "type": "object", "additionalProperties": false,
      "required": ["source_aoi_id", "exposure_id_prefixes", "visual_features"],
      "properties": {
        "source_aoi_id": { "$ref": "#/$defs/id" },
        "exposure_id_prefixes": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "\\.$" } },
        "visual_features": { "$ref": "#/$defs/visualFeatures" }
      }
    }
  }
}
