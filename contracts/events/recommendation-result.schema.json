{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcm-lookbook.example/contracts/v1/events/recommendation-result.schema.json",
  "title": "RecommendationResult",
  "description": "추천 실행 상태와 Top 2 상품을 전달합니다. 신호 가중치와 모델 내부 점수는 포함하지 않습니다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recommendation_id",
    "session_id",
    "video_id",
    "manifest_version",
    "algorithm_version",
    "engine_mode",
    "status",
    "items",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "recommendation_id": {
      "$ref": "#/$defs/id"
    },
    "session_id": {
      "$ref": "#/$defs/id"
    },
    "video_id": {
      "$ref": "#/$defs/id"
    },
    "manifest_version": {
      "$ref": "#/$defs/version"
    },
    "algorithm_version": {
      "$ref": "#/$defs/version"
    },
    "engine_mode": {
      "enum": [
        "mock",
        "research_version"
      ]
    },
    "status": {
      "enum": [
        "pending",
        "completed",
        "insufficient_data",
        "failed"
      ]
    },
    "items": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "reason": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/reason"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "minItems": 2,
            "maxItems": 2
          },
          "reason": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "items": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "insufficient_data",
              "failed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "$ref": "#/$defs/reason"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "pending"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "product_id"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "product_id": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
