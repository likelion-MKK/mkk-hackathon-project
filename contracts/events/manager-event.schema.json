{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcm-lookbook.example/contracts/v1/events/manager-event.schema.json",
  "title": "ManagerEvent",
  "description": "고객의 S04 제품 요청을 매니저 화면에 전달하는 polling 이벤트입니다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "sequence",
    "session_id",
    "kiosk_id",
    "event_type",
    "emitted_at",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "$ref": "#/$defs/id"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "session_id": {
      "$ref": "#/$defs/id"
    },
    "kiosk_id": {
      "$ref": "#/$defs/id"
    },
    "event_type": {
      "enum": [
        "session_started",
        "recommendation_ready",
        "customer_product_request"
      ]
    },
    "emitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "session_started"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "customer_product_request"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/customer_product_request_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "recommendation_ready"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/recommendation_payload"
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "product_id"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "product_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "recommendation_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendation_id",
        "engine_mode",
        "items"
      ],
      "properties": {
        "recommendation_id": {
          "$ref": "#/$defs/id"
        },
        "engine_mode": {
          "enum": [
            "mock",
            "research_version"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "customer_product_request_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "recommendation_id",
        "engine_mode",
        "items"
      ],
      "properties": {
        "intent": {
          "const": "view_recommended_products"
        },
        "recommendation_id": {
          "$ref": "#/$defs/id"
        },
        "engine_mode": {
          "enum": [
            "mock",
            "research_version"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    }
  }
}
