{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcm-lookbook.example/contracts/v1/product-catalog.schema.json",
  "title": "ProductCatalog",
  "description": "상품 ID를 표시 정보, 공식 상품 URL, 사전 생성 QR 자산과 연결합니다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "products"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "catalog_version": {
      "$ref": "#/$defs/version"
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/product"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_id",
        "display_name",
        "category",
        "image_url",
        "product_url",
        "qr_asset_path"
      ],
      "properties": {
        "product_id": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "image_url": {
          "type": "string",
          "format": "uri"
        },
        "product_url": {
          "type": "string",
          "format": "uri"
        },
        "qr_asset_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*\\.png$"
        }
      }
    }
  }
}
