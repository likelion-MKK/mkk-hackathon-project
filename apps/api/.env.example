# Running API only: Supabase IPv4 session pooler on port 5432. Never expose this to Vite/browser code.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DB_CONNECT_TIMEOUT_SECONDS=5

# Administrative tooling only: Supabase direct PostgreSQL connection on port 5432.
# Do not inject this variable into the running API or browser containers.
MIGRATION_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Production provider decision: hosted Luna. Do not put the API key in Git.
CENTRAL_AI_PROVIDER=openai_luna
OPENAI_API_KEY=
CENTRAL_AI_MODEL_ID=gpt-5.6-luna
CENTRAL_AI_MODEL_REVISION=gpt-5.6-luna
CENTRAL_AI_REASONING_EFFORT=max
CENTRAL_AI_REASONING_CONTEXT=current_turn
CENTRAL_AI_INPUT_VARIANT=C
CENTRAL_AI_PROMPT_VERSION=central-recommender-ko-v4

# The following self-hosted variables are retained only for the migration seam;
# they must remain unset when CENTRAL_AI_PROVIDER=openai_luna.
CENTRAL_AI_ENDPOINT=
CENTRAL_AI_BEARER_TOKEN=
CENTRAL_AI_BENCHMARK_APPROVAL=
CENTRAL_AI_TIMEOUT_SECONDS=

# One shared secret is injected into API and Vision Gateway containers only.
# Generate it outside Git (for example: openssl rand -hex 32).
VISION_STREAM_TOKEN_SECRET=
VISION_EYE_WORKER_URL=http://eye-worker:8766
VISION_FACE_MODEL_PATH=/srv/mcm/models/face_landmarker.task

KIOSK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
V2_COLLECTING_TTL_SECONDS=300
V2_PENDING_TTL_SECONDS=1800
V2_DECISION_TTL_SECONDS=900
V2_ORPHAN_JOB_SECONDS=1800
V2_JOB_RETENTION_SECONDS=86400
V2_MAINTENANCE_INTERVAL_SECONDS=60

# Canonical actual-video readiness. Production must mount this path read-only.
LOOKBOOK_VIDEO_PATH=apps/kiosk/public/media/mcm-lookbook-v2.mp4
REQUIRE_LOOKBOOK_MEDIA_READINESS=false

# v1 compatibility only.
RECOMMENDATION_ENGINE=mock
