# Apply apps/api/migrations/0001_central_recommendation_v2.sql first.
DATABASE_URL=postgresql://mcm_app:replace-me@127.0.0.1:5432/mcm_lookbook

# Loopback HTTP is development-only. Production requires HTTPS and bearer auth.
CENTRAL_AI_ENDPOINT=http://127.0.0.1:9000/recommend
CENTRAL_AI_BEARER_TOKEN=
CENTRAL_AI_MODEL_ID=self-hosted-central-model
CENTRAL_AI_MODEL_REVISION=pin-exact-revision
CENTRAL_AI_PROMPT_VERSION=central-recommender-ko-v2
CENTRAL_AI_INPUT_VARIANT=C
# Required for non-loopback endpoints; record the approved benchmark decision ID.
CENTRAL_AI_BENCHMARK_APPROVAL=
CENTRAL_AI_TIMEOUT_SECONDS=10

KIOSK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
V2_COLLECTING_TTL_SECONDS=300
V2_PENDING_TTL_SECONDS=60
V2_DECISION_TTL_SECONDS=900

# v1 compatibility only.
RECOMMENDATION_ENGINE=mock
